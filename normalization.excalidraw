    },
    {
      "type": "text",
      "version": 88,
      "versionNonce": 1334516751,
      "index": "bBZ",
      "isDeleted": false,
      "id": "eY0mZJCxrL5HSARedEjXP",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2666.739855800035,
      "y": -609.2084786248035,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "width": 794.4993896484375,
      "height": 75,
      "seed": 1806532513,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1725477990253,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "- Data redundancy occurs when the same piece of data is stored in multiple \nplaces. This can lead to wasted storage space and the risk of inconsistent data\nif updates are not applied everywhere.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Data redundancy occurs when the same piece of data is stored in multiple places. This can lead to wasted storage space and the risk of inconsistent data if updates are not applied everywhere.",
      "autoResize": false,
      "lineHeight": 1.25
    },
