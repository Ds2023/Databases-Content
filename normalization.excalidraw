      "updated": 1725478868537,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "- Insertion anomalies occur when certain data cannot be added to the database without the presence \nof other unnecessary data.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Insertion anomalies occur when certain data cannot be added to the database without the presence of other unnecessary data.",
      "autoResize": false,
      "lineHeight": 1.25
    },
