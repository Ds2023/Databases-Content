    {
      "id": "BTujAYZrmXVkeV6rIvEVR",
      "type": "text",
      "x": 2807.4603148591245,
      "y": 3439.8244165627075,
      "width": 903.1767580065525,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jMHgf_qQNeMcMKam5j8CC"
      ],
      "frameId": null,
      "index": "bJu",
      "roundness": null,
      "seed": 936074305,
      "version": 152,
      "versionNonce": 634183009,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1725484188335,
      "link": null,
      "locked": false,
      "text": "- A multi-valued dependency occurs when one attribute in a table uniquely determines \nanother attribute, independently of other attributes. \n- In other words, a single attribute should not be able to determine multiple independent \nsets of attributes.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- A multi-valued dependency occurs when one attribute in a table uniquely determines another attribute, independently of other attributes. \n- In other words, a single attribute should not be able to determine multiple independent sets of attributes.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
