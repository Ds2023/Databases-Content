      "fontSize": 20,
      "fontFamily": 5,
      "text": "- Imagine you want to add a new customer to the database who hasn’t placed \nany orders yet. In a non-normalized table, you might be forced to insert a dummy\norder just to store the customer’s information.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Imagine you want to add a new customer to the database who hasn’t placed any orders yet. In a non-normalized table, you might be forced to insert a dummy order just to store the customer’s information.",
      "autoResize": false,
      "lineHeight": 1.25
    },
