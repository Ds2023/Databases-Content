      "updated": 1725484188335,
      "link": null,
      "locked": false,
      "text": "This table implies that each vendor supplies specific parts for specific projects.\nHowever, this information is not explicit, leading to potential anomalies if not \nhandled correctly.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This table implies that each vendor supplies specific parts for specific projects. However, this information is not explicit, leading to potential anomalies if not handled correctly.",
      "autoResize": false,
      "lineHeight": 1.25
    },
