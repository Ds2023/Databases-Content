      "angle": 0,
      "x": 2667.112314323945,
      "y": -482.4791066924038,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffec99",
      "width": 953.8031898687035,
      "height": 75,
      "seed": 722950383,
