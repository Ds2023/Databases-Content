      "locked": false,
      "text": "A combination of course and professor uniquely determines the room.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A combination of course and professor uniquely determines the room.",
