      "updated": 1725484203562,
      "link": null,
      "locked": false,
      "text": "A table is in 1NF if:",
      "fontSize": 20.52048363339218,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A table is in 1NF if:",
