      "isDeleted": false,
      "boundElements": null,
      "updated": 1725484188335,
      "link": null,
      "locked": false,
      "text": "- The Course determines the Room (e.g., History → Room 101 or Room 102).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- The Course determines the Room (e.g., History → Room 101 or Room 102).",
