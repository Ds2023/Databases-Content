    {
      "id": "D1Q2vx1xIo3mjBpy8af1h",
      "type": "text",
      "x": 1808.2284879261365,
      "y": 3441.2508154866773,
      "width": 636.33544921875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jMHgf_qQNeMcMKam5j8CC"
      ],
      "frameId": null,
      "index": "bJ1",
      "roundness": null,
      "seed": 1104327343,
      "version": 123,
      "versionNonce": 950063535,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1725484188335,
      "link": null,
      "locked": false,
      "text": "For every functional dependency (X → Y), X should be a superkey.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For every functional dependency (X → Y), X should be a superkey.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "oLmfd5TJow_9eVRklw31D",
      "type": "text",
      "x": 1744.5305064879403,
      "y": 3522.5798935510275,
      "width": 799.8195190429688,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jMHgf_qQNeMcMKam5j8CC"
      ],
      "frameId": null,
      "index": "bJ2",
      "roundness": null,
      "seed": 680525121,
      "version": 135,
      "versionNonce": 1003594945,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1725484188335,
      "link": null,
      "locked": false,
      "text": "3NF eliminates most redundancy but doesn't handle cases where there are \noverlapping candidate keys, which can still cause anomalies.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3NF eliminates most redundancy but doesn't handle cases where there are overlapping candidate keys, which can still cause anomalies.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "Y-6xbrr10Isz1REeKQLPy",
      "type": "text",
      "x": 1746.9432844899343,
