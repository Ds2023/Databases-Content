      "fontSize": 28,
      "fontFamily": 5,
      "text": "Data Redundancy",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "8siNJtX8HNq7d1171ZNjJ",
      "originalText": "Data Redundancy",
      "autoResize": true,
