      "locked": false,
      "text": "- Boyce-Codd Normal Form is a stricter version of the Third Normal Form (3NF).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Boyce-Codd Normal Form is a stricter version of the Third Normal Form (3NF).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 264,
