    {
      "type": "text",
      "version": 98,
      "versionNonce": 1366751745,
      "index": "bC2",
      "isDeleted": false,
      "id": "yQk8ypFiILGluM5Z_F1oO",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 2660.7755593105894,
      "y": 20.576717779695855,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "width": 1032.1877586111752,
      "height": 75,
      "seed": 183951233,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1725478774954,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "- When redundant data exists, updating it can be error-prone. \n- If all instances of the data are not updated consistently, this leads to anomalies where some parts of\nthe database reflect the old data while others reflect the new data.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- When redundant data exists, updating it can be error-prone. \n- If all instances of the data are not updated consistently, this leads to anomalies where some parts of the database reflect the old data while others reflect the new data.",
      "autoResize": false,
      "lineHeight": 1.25
    },
