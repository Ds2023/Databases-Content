      "updated": 1725484188335,
      "link": null,
      "locked": false,
      "text": "A table is in Fifth Normal Form if:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A table is in Fifth Normal Form if:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "type": "text",
      "version": 97,
      "versionNonce": 737331407,
      "index": "bKL",
      "isDeleted": false,
      "id": "vo4zwLHuQyol7zMt_CzAx",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "angle": 0,
      "x": 3965.7610226185643,
      "y": 3343.2837352475563,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "width": 134.3599090576172,
      "height": 25,
      "seed": 599439137,
      "groupIds": [
        "jMHgf_qQNeMcMKam5j8CC"
      ],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1725484188335,
      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 5,
      "text": "- It is in 4NF.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- It is in 4NF.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "xgOoXp8Vio5J02mHmcA2s",
      "type": "text",
      "x": 3964.4482238683886,
      "y": 3369.9960096697573,
      "width": 645.6896795728035,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jMHgf_qQNeMcMKam5j8CC"
      ],
      "frameId": null,
      "index": "bKM",
      "roundness": null,
      "seed": 836503055,
      "version": 164,
      "versionNonce": 1477848993,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1725484188335,
      "link": null,
      "locked": false,
      "text": "- It cannot be decomposed into two or more tables without \nlosing information (i.e., it has no join dependency).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- It cannot be decomposed into two or more tables without losing information (i.e., it has no join dependency).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "qf1hoEMJqnRY_j2sHiN0_",
      "type": "text",
      "x": 3918.072195388113,
      "y": 3439.9632367860245,
      "width": 778.87939453125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "jMHgf_qQNeMcMKam5j8CC"
      ],
      "frameId": null,
      "index": "bKN",
      "roundness": null,
      "seed": 1359781199,
      "version": 105,
      "versionNonce": 2136921839,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1725484188335,
      "link": null,
      "locked": false,
      "text": "- 5NF deals with cases where data anomalies could occur due to complex \nrelationships between entities, which cannot be resolved by simply applying 4NF.\n- It ensures that the database can be reconstructed from its decomposed \ntables without any loss of information.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- 5NF deals with cases where data anomalies could occur due to complex relationships between entities, which cannot be resolved by simply applying 4NF. - It ensures that the database can be reconstructed from its decomposed tables without any loss of information.",
      "autoResize": false,
      "lineHeight": 1.25
    },
